{
  "name": "prodshop",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4.4.0",
    "@sap-cloud-sdk/resilience": "^4.4.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.1.2",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-productshop": "cds watch --open ns.productshop/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-products": "cds watch --open ns.products/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-project1": "cds watch --open ns.project1/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/productshop",
    "app/productshop",
    "app/products",
    "app/products",
    "app/products",
    "app/products",
    "app/project1"
  ],
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "john": {
              "roles": [
                "productmanager"
              ]
            },
            "mario": {
              "password": "initial",
              "roles": [
                "productmanager"
              ]
            },
            "henry": {
              "roles": [
                "productdeveloper"
              ]
            }
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "credential": {
          "database": "db.sqlite"
        }
      },
      "ProductMasterA2X": {
        "kind": "odata-v2",
        "model": "srv/external/ProductMasterA2X",
        "[production]": {
          "credentials": {
            "path": "s4hanacloud/sap/opu/odata/sap/API_PRODUCT_SRV"
          }
        },
        "[development]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com",
            "path": "s4hanacloud/sap/opu/odata/sap/API_PRODUCT_SRV",
            "headers": {
              "APIKey": "YyeXU1CKp13NAZrWbqywCmmacDli5gWz"
            }
          }
        }
      }
    }
  }
}
